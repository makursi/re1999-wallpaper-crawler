# The site's constants, shipped with the program (#86).
#
# `pnpm package` writes this file into the archive as app\.env. It is the only
# configuration a release carries: the repository's own .env is the owner's
# local file, it is gitignored, and the packager never reads it.
#
# Every key below is validated by the same schema a Run parses
# (core/config-read.ts). BASE_ORIGIN is the one key that has no default; the
# others are optional and default to the data directory's layout.
#
# The owner's personal overrides belong in data\user.env, which an update never
# replaces and which wins over this file.
BASE_ORIGIN=https://re.bluepoch.com
