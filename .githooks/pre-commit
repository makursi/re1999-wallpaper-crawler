#!/bin/sh
# Never commit on the default branch. All work lands on main only through a
# merged PR (AGENTS.md › Git Conventions).
#
# Activated per clone with:  git config core.hooksPath .githooks
# Emergency bypass (say why afterwards):  git commit --no-verify

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

if [ -z "$branch" ]; then
  echo "pre-commit: refusing to commit with a detached HEAD." >&2
  echo "            Branch first: git switch -c <type>/<slug>" >&2
  exit 1
fi

case "$branch" in
  main | master)
    echo "pre-commit: refusing to commit on '$branch'." >&2
    echo "            Work lands on $branch only through a merged PR." >&2
    echo "            Branch first: git switch -c <type>/<slug>" >&2
    exit 1
    ;;
esac

exit 0
