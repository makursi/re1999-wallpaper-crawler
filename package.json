{
  "name": "re1999-wallpaper-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Wallpaper scraper for Bluepoch's official gallery (re.bluepoch.com)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "core:run": "tsx core/main.ts",
    "check-run": "tsx core/check-run.ts",
    "build": "tsx scripts/build.ts",
    "package": "pnpm build && tsx scripts/package.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "webui": "tsx scripts/webui.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "dotenv": "^17.4.2",
    "hono": "4.13.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "0.28.2",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reka-ui": "^2.11.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-branch.mjs && pnpm exec lint-staged",
    "pre-push": "pnpm typecheck && pnpm test"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,vue}": "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
    "*.{ts,mjs,cjs,js,json,vue}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.3.4"
}
