{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["oxc", "typescript", "unicorn", "import", "node", "promise", "vitest", "vue"],
  "rules": {
    // `!= null` is deliberate: it catches both null and undefined (see
    // report.ts › classifyOutcomes).
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-debugger": "error",
    "no-console": ["warn", { "allow": ["error"] }],
    // Loading dotenv for its side effect is the point of the import, and so are
    // UnoCSS's generated stylesheet and the self-hosted font packages: the
    // virtual module *is* the stylesheet, and a `@fontsource-variable` import
    // *is* its `@font-face` rules, so there is no binding to assign.
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["dotenv/config", "virtual:uno.css", "@fontsource-variable/*"] }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "warn"
  },
  // `web/dist` (the built page) and `web/.console-cache` (the thumbnail cache)
  // are deliberately NOT listed below: `.gitignore` owns both exclusions and
  // this tool honours it on its walk (conventions §8.2), so listing them here
  // again would only duplicate the reason. An explicit path is still visited —
  // which is why the build output stays gitignored rather than being linted.
  "ignorePatterns": ["node_modules", "images", "logs", ".playwright", ".playwright-cli", "**/*.md"]
}
