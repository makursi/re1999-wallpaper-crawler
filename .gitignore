node_modules/
# The user's data directory (#80): the Mirror, the Run logs, the thumbnail cache
# and data/user.env. It is a sibling of the program directory in the package and
# a child of the repository in a source checkout; either way it is the user's,
# not the program's, so it never enters git.
data/
# The pre-#80 locations, still ignored so an un-migrated checkout stays clean.
# The first start moves them into data/ by rename (core/data-layout.ts).
images/
logs/
.playwright/
.playwright-cli/
# The Console's build artifact, under its layer directory. Named by path rather
# than as a bare `dist/`, because the layer owns it and a stray root-level
# `dist/` would belong to nobody.
web/dist/
# The built tree (#84): the two bundled entries, the copied page and the tree's
# package metadata. `pnpm build` writes it, a package ships it, and it is never
# source — `node build/server.js` is how the program runs.
build/
# The pre-#80 thumbnail cache; moved to data/cache/ after the first start.
web/.console-cache/
*.log
.env
.env.local
explain/
