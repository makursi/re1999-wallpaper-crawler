# Editor-level style for files outside the linter's reach. Deliberately says
# nothing about line endings: this repository stores CRLF in git history and the
# policy is unsettled — see HISTORY.md › 开放问题 (it must be settled before a
# formatter, which writes LF, is adopted).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
