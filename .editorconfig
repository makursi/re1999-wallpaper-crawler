# Editor defaults for files outside the toolchain's reach (markdown, and anything
# oxfmt does not format). Line endings are LF everywhere: see `.gitattributes`
# and AGENTS.md › Gotchas › "Git history is LF, the Windows worktree is CRLF".
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
