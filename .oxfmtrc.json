{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "sortImports": true,
  // `web/dist` (the built page) and `web/.console-cache` (the thumbnail cache)
  // are deliberately NOT listed below: `.gitignore` owns both exclusions and
  // this tool honours it on its walk (conventions §8.2), so listing them here
  // again would only duplicate the reason. An explicit path is still visited —
  // which is why the build output stays gitignored rather than being formatted.
  "ignorePatterns": [
    "node_modules",
    "images",
    "logs",
    ".playwright",
    ".playwright-cli",
    "pnpm-lock.yaml",
    "TRASH.md",
    "**/*.md"
  ]
}
